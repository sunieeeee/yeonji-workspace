{
	"name": "@yeonji/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"**/*.css.ts"
	],
	"files": [
		"dist"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./index.css": {
			"types": "./dist/index.css.d.ts",
			"default": "./dist/index.css"
		}
	},
	"scripts": {
		"build": "tsup && npm run build:css-types",
		"build:css-types": "node -e \"require('fs').writeFileSync('dist/index.css.d.ts', 'declare module \\\"@yeonji/ui/index.css\\\";\\n')\"",
		"dev": "tsup --watch"
	},
	"peerDependencies": {
		"react": "^18",
		"react-dom": "^18"
	},
	"devDependencies": {
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vanilla-extract/esbuild-plugin": "^2.3.22",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@vanilla-extract/css": "^1.21.2",
		"@vanilla-extract/recipes": "^0.5.7",
		"pretendard": "^1.3.9"
	}
}
